BGG_API_TOKEN=inserisci-qui-il-tuo-token-bgg

# WordPress (per la creazione automatica di articoli in bozza)
# WP_URL: URL del sito, senza slash finale (es. https://www.volpegiocosa.it)
# WP_USER: nome utente WordPress
# WP_APP_PASSWORD: Application Password generata da Utenti > Profilo > Application Passwords
WP_URL=https://www.volpegiocosa.it
WP_USER=inserisci-qui-il-tuo-username-wp
WP_APP_PASSWORD=inserisci-qui-la-tua-application-password
